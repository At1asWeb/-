# =========================
# Telegram
# =========================

BOT_TOKEN=
ADMIN_IDS=


# =========================
# Proxy (SOCKS5, для Telegram и yt-dlp)
# =========================

PROXY_ENABLED=true
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=


# =========================
# Banner (значения по умолчанию, админ может менять в боте)
# =========================

BANNER_WIDTH_PERCENT=75
# Высота в % от высоты видео. 0 = авто (по пропорциям баннера).
BANNER_HEIGHT_PERCENT=0
# Как вписать баннер, если высота задана: fit | crop | stretch
BANNER_FIT=fit
BANNER_TOP_OFFSET_PERCENT=10
BANNER_OPACITY=0.95
BANNER_LOOP=true


# =========================
# Music (громкость по умолчанию = среднее MIN и MAX)
# =========================

MUSIC_VOLUME_MIN=0.01
MUSIC_VOLUME_MAX=0.03


# =========================
# Subtitles
# =========================

WHISPER_LANGUAGE=ru


# =========================
# yt-dlp cookies
# Файл cookies (Netscape-формат) имеет приоритет над браузером.
# Оставьте оба пустыми, чтобы качать без cookies.
# =========================

YTDLP_COOKIES_BROWSER=chrome
YTDLP_COOKIES_FILE=


# =========================
# Limits
# =========================

TEMP_FILE_MAX_AGE_HOURS=6
PROCESSING_TIMEOUT_SECONDS=1800

MAX_VIDEO_DURATION=300
# Сколько ссылок можно отправить одним списком (пакетная обработка)
MAX_BATCH_SIZE=30
MAX_INPUT_SIZE_MB=200
MAX_OUTPUT_SIZE_MB=200

# Лимит отправки файлов ботом. Пусто = 50 МБ (обычный Bot API)
# или 2000 МБ, если задан TELEGRAM_API_URL. Результат больше лимита
# будет автоматически сжат (в два прохода, звук без потерь).
TELEGRAM_UPLOAD_LIMIT_MB=

# Локальный Telegram Bot API сервер (https://github.com/tdlib/telegram-bot-api)
# снимает лимит 50 МБ: бот отправляет файлы до 2000 МБ без сжатия.
# Пример: http://localhost:8081. Если задан и TELEGRAM_UPLOAD_LIMIT_MB
# не указан, лимит = 2000.
TELEGRAM_API_URL=


# =========================
# Качество видео
# =========================

# 17–18 — визуально без потерь, 20–23 — легче файл. Меньше = лучше.
VIDEO_CRF=17
# ultrafast … medium, slow, slower. Медленнее = лучше при том же размере.
VIDEO_PRESET=slow
AUDIO_BITRATE_KBPS=256
