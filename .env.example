# =========================
# Telegram
# =========================

BOT_TOKEN=
ADMIN_IDS=


# =========================
# Proxy (SOCKS5, для Telegram и yt-dlp)
# =========================

PROXY_ENABLED=true
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=


# =========================
# Banner (значения по умолчанию, админ может менять в боте)
# =========================

BANNER_WIDTH_PERCENT=75
# Высота в % от высоты видео. 0 = авто (по пропорциям баннера).
BANNER_HEIGHT_PERCENT=0
# Как вписать баннер, если высота задана: fit | crop | stretch
BANNER_FIT=fit
BANNER_TOP_OFFSET_PERCENT=10
BANNER_OPACITY=0.95
BANNER_LOOP=true


# =========================
# Music (громкость по умолчанию = среднее MIN и MAX)
# =========================

MUSIC_VOLUME_MIN=0.01
MUSIC_VOLUME_MAX=0.03


# =========================
# Subtitles
# =========================

WHISPER_LANGUAGE=ru


# =========================
# yt-dlp cookies
# Файл cookies (Netscape-формат) имеет приоритет над браузером.
# Оставьте оба пустыми, чтобы качать без cookies.
# =========================

YTDLP_COOKIES_BROWSER=chrome
YTDLP_COOKIES_FILE=


# =========================
# Limits
# =========================

TEMP_FILE_MAX_AGE_HOURS=6
PROCESSING_TIMEOUT_SECONDS=1800

MAX_VIDEO_DURATION=300
MAX_INPUT_SIZE_MB=200
MAX_OUTPUT_SIZE_MB=200

# Лимит отправки файлов ботом (Telegram Bot API = 50 МБ).
# Результат больше лимита будет автоматически сжат.
TELEGRAM_UPLOAD_LIMIT_MB=50
